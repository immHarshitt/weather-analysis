# Python bytecode/caches
__pycache__/
*.py[cod]
*$py.class

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Virtual environments
venv/
.venv/
env/

# IDE files
.vscode/
.idea/
.DS_Store

# Streamlit config/cache
.streamlit/

# Log files
*.log

